datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Session {
  id             String    @id @default(uuid())
  title          String    @default("New Conversation")
  systemPrompt   String    @default("You are a helpful and knowledgeable AI assistant.")
  model          String    @default("gpt-4o-mini")
  temperature    Float     @default(0.7)
  maxTokens      Int       @default(1500)
  responseFormat String    @default("text") // "text" | "json_object"
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  messages       Message[]

  @@map("sessions")
}

model Message {
  id               String   @id @default(uuid())
  sessionId        String
  session          Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role             String   // "system" | "user" | "assistant"
  content          String   @db.Text
  structuredData   Json?    // Stores parsed structured JSON when responseFormat == "json_object"
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  latencyMs        Int      @default(0)
  createdAt        DateTime @default(now())

  @@index([sessionId])
  @@map("messages")
}
