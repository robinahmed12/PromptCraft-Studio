# Neon DB PostgreSQL Connection String (Required)
# Format: postgresql://<user>:<password>@<neon-endpoint>.neon.tech/<dbname>?sslmode=require
DATABASE_URL="postgresql://user:password@endpoint.neon.tech/neondb?sslmode=require"

# Server Port
PORT=5000

# OpenAI API Key (Optional: if empty or USE_MOCK_LLM=true, simulated offline engine is used)
OPENAI_API_KEY=""

# Mode switch: Set to true to force simulated mock LLM
USE_MOCK_LLM=false
